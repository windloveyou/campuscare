# These variables are read from the process environment, not auto-loaded from .env.
# Recommended: admin > 邮件服务 in the local app. No environment setup required.
# Saved data/mail-settings.json takes precedence over environment configuration.
# Use "demo" only for explicit local testing; it displays codes without sending.
CAMPUSCARE_MAIL_MODE=disabled

# For actual delivery, set mode=smtp and configure the following privately.
# CAMPUSCARE_MAIL_MODE=smtp
# CAMPUSCARE_SMTP_HOST=smtp.example.com
# CAMPUSCARE_SMTP_PORT=465
# CAMPUSCARE_SMTP_TLS=ssl
# CAMPUSCARE_SMTP_FROM=campus@example.com
# CAMPUSCARE_SMTP_USER=campus@example.com
# CAMPUSCARE_SMTP_PASSWORD=your-provider-app-password
